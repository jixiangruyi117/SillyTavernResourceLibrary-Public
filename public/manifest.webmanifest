{
  "name": "SRL_Pubilc",
  "short_name": "SRL_Pubilc",
  "description": "本地优先的 SillyTavern 资源管理工具",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#E8F3F5",
  "theme_color": "#E8F3F5",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["image/png", "application/json", "text/plain", ".png", ".json", ".txt", ".css"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icons/srl-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/srl-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/srl-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/srl-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
